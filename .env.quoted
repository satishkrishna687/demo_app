LLM_PROVIDER = "openai"
LLM_MODEL = "qwen/qwen3.7-flash"
LLM_BASE_URL = "https://openrouter.ai/api/v1"
LLM_API_KEY_ENV = "OPENROUTER_API_KEY"
OLLAMA_BASE_URL = "http://localhost:11434"

EMBEDDING_PROVIDER = "openai"
EMBEDDING_MODEL = "qwen/qwen3-embedding-8b"
EMBEDDING_BASE_URL = "https://openrouter.ai/api/v1"
EMBEDDING_API_KEY_ENV = "OPENROUTER_API_KEY"
EMBEDDING_USE_PROMPTS = "auto"
EMBEDDING_QUERY_PROMPT_NAME = "query"
EMBEDDING_DOC_PROMPT_NAME = "document"
EMBEDDING_STRIP_TABLES = "1"

RERANKER_MODEL = "BAAI/bge-reranker-v2-m3"
RERANKER_MAX_LENGTH = "1024"

DEVICE = ""

CHROMA_PERSIST_DIR = "./chroma_db"

TOP_K = "5"
HYBRID_VECTOR_WEIGHT = "0.6"
HYBRID_BM25_WEIGHT = "0.4"
RERANK_TOP_N = "20"

ISO_PDF_DIR = "./Iso"

DOCLING_CACHE_DIR = "./data/parsed"
DOCLING_BATCH_SIZE = "1"
VECTORSTORE_BATCH_SIZE = "1000"
